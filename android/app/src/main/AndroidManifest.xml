<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="tv.danmaku.bili" />
        <package android:name="moe.shizuku.privileged.api" />
        <provider android:authorities="tv.danmaku.bili.providers.BiliDataProvider" />
    </queries>

    <application
        android:name=".MengzhenMusicApplication"
        android:appComponentFactory=".QqMusicAppComponentFactory"
        tools:replace="android:appComponentFactory"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="tinker_version"
            android:value="1.9.15.2" />
        <meta-data
            android:name="TINKER_ID"
            android:value="tinker_id_qqmusic_20.6.5.8.r084ec4a8_20260714153130_64" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.bilibili.com" />
                <data android:scheme="https" android:host="b23.tv" />
            </intent-filter>

        </activity>

        <activity
            android:name=".auth.TurnstileChallengeActivity"
            android:exported="false"
            android:theme="@style/AppTheme.TransparentChallenge" />

        <activity
            android:name="com.tencent.picker.activity.PictureSelectorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/os" />

        <!-- QQ Music lock screen Activity (not declared by qqmusic-runtime manifest) -->
        <activity
            android:name="com.tencent.qqmusic.business.lockscreennew.LockScreenActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="singleInstance"
            android:resizeableActivity="true"
            android:screenOrientation="portrait"
            android:taskAffinity="android.task.qqmusiclock"
            android:theme="@style/ol" />

        <!-- Foreground Service for audio playback -->
        <service
            android:name=".audio.AudioPlaybackService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- QQPlayerServiceNew is declared by qqmusic-runtime manifest
             (process=:QQPlayerService, foregroundServiceType=mediaPlayback).
             QqMusicAppComponentFactory redirects instantiation to QqMusicServiceCompat. -->

        <!-- 喜马拉雅播放器使用的普通绑定式 SustainedListenService -->
        <service
            android:name=".audio.SustainedListenService"
            android:enabled="true"
            android:exported="false" />

        <!-- AlarmManager receiver -->
        <receiver
            android:name=".receiver.AlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Boot receiver to restore alarms after device restart -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Note: ScreenStatusReceiver is dynamically registered in AudioPlaybackService.onCreate(),
             do NOT statically register here to avoid duplicate reception -->

        <!-- MediaButtonReceiver is declared by qqmusic-runtime manifest
             (process=:QQPlayerService, exported=false). -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider;${applicationId}.fileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/a3" />
        </provider>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- WakeLock for CPU during sleep -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Exact alarm (Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Boot receiver -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- QQ Music source image picker reads the MediaStore grid directly. -->
    <!-- targetSdk is currently 32, so Android 13+ still grants MediaStore access
         through the legacy permission. Remove this once targetSdk moves to 33+. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Keep CPU running during sleep for playback -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Phone state for pausing during calls -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Access WiFi state for WifiLock -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Access network state -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Offline voice search -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Modify audio settings (ExoPlayer volume control) - 对标喜马拉雅 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Vibrate for alarm trigger - 对标喜马拉雅 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Disable keyguard for QQ Music lock screen Activity -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <!-- Bluetooth for QQ Music MediaSessionController and AudioPlaybackService A2DP receiver -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

</manifest>
