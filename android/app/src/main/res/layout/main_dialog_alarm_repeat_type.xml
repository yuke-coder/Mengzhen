<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/xm_alarm_v9514_0x7f0818ac"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ListView
        android:id="@+id/main_repeat_setting_list"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:cacheColorHint="#00000000"
        android:divider="@color/xm_alarm_v9514_0x7f060cb7"
        android:dividerHeight="1px"/>
    <View
        android:background="@color/xm_alarm_v9514_0x7f060cb6"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/xm_alarm_v9514_0x7f060ac6"
        android:gravity="center"
        android:id="@+id/main_repeat_setting_complete"
        android:background="@color/xm_alarm_v9514_0x7f060d8b"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="完成"/>
</LinearLayout>
