<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <include
        android:id="@+id/main_title_bar"
        layout="@layout/ximalaya_alarm_title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/arg_res_0x7f0702b1"
        android:layout_alignParentTop="true" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/main_title_bar">

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:background="#FFF3F4F5" />

        <ImageView
            android:id="@+id/main_iv_success"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="40dp"
            android:contentDescription="发送成功提示图片"
            android:src="@drawable/xm_feedback_success" />

        <TextView
            android:id="@+id/main_fbs_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/main_iv_success"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="40dp"
            android:text="发送成功"
            android:textColor="#FF333333"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/main_tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/main_fbs_title"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="20dp"
            android:gravity="center"
            android:text="感谢你的关注和支持，我们会认真处理您的反馈，尽快修复和完善相关功能"
            android:textColor="#FF999999"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/main_finish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/main_tv_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="15dp"
            android:background="@drawable/xm_feedback_detail_submit"
            android:gravity="center"
            android:padding="10dp"
            android:text="完成"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />
    </RelativeLayout>
</RelativeLayout>
