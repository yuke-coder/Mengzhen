<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/Wh0"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_line_height"
        android:background="@color/Ga2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/check_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkbox"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="8dp"
                android:background="@null"
                android:button="@drawable/selector_compound_round"
                android:padding="0dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackgroundBorderless"
                android:text="全选"
                android:textColor="@color/Ga8"
                android:textSize="@dimen/text_size_subtitle" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/extract"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="36dp"
            android:layout_marginRight="24dp"
            android:background="?selectableItemBackgroundBorderless"
            android:text="提取音频"
            android:textColor="@color/Pi5"
            android:textSize="@dimen/text_size_subtitle" />
    </LinearLayout>
</LinearLayout>
