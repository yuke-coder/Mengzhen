<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3F4F5"
    android:orientation="vertical">

    <include
        android:id="@+id/main_title_bar"
        layout="@layout/ximalaya_alarm_title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/arg_res_0x7f0702b1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="60dp">

            <TextView
                style="@style/XmSettingSourceSectionTitle"
                android:text="反馈信息" />

            <TextView
                android:id="@+id/main_feedback_record_type"
                style="@style/XmSettingSourceFilledLinkRow"
                android:clickable="false"
                android:drawableEnd="@null" />

            <TextView
                android:id="@+id/main_feedback_record_time"
                style="@style/XmSettingSourceFilledLinkRow"
                android:clickable="false"
                android:drawableEnd="@null" />

            <TextView
                style="@style/XmSettingSourceSectionTitle"
                android:text="反馈内容" />

            <TextView
                android:id="@+id/main_feedback_record_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFFFF"
                android:padding="15dp"
                android:textColor="#FF575757"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <TextView
                style="@style/XmSettingSourceSectionTitle"
                android:text="联系方式" />

            <TextView
                android:id="@+id/main_feedback_record_contact"
                style="@style/XmSettingSourceFilledLinkRow"
                android:clickable="false"
                android:drawableEnd="@null" />

            <TextView
                android:id="@+id/main_feedback_record_image_title"
                style="@style/XmSettingSourceSectionTitle"
                android:text="反馈图片" />

            <GridView
                android:id="@+id/main_feedback_record_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="40dp"
                android:columnWidth="80dp"
                android:horizontalSpacing="10dp"
                android:numColumns="3"
                android:scrollbars="none"
                android:stretchMode="columnWidth"
                android:verticalSpacing="10dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
