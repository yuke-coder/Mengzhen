<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/main_item_divider_top"
        android:background="@color/arg_res_0x7f060d48"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="6dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:paddingTop="@dimen/arg_res_0x7f0703b1"
        android:paddingBottom="@dimen/arg_res_0x7f0703b1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/main_play_more_action_item_iv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="centerCrop"
                android:tint="@color/arg_res_0x7f060619"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/arg_res_0x7f060ac8"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/main_play_more_action_item_tag_tv"
                android:background="@drawable/arg_res_0x7f082c11"
                android:paddingLeft="3dp"
                android:paddingTop="2dp"
                android:paddingRight="3dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="20dp"
                android:minHeight="15dp"
                android:includeFontPadding="false"/>
        </FrameLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/arg_res_0x7f060ac8"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/main_play_more_action_item_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/arg_res_0x7f060602"
            android:ellipsize="end"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/main_play_more_action_item_subtitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_weight="1"/>
        <CheckBox
            android:enabled="false"
            android:id="@+id/main_cb_switch"
            android:background="@drawable/arg_res_0x7f080dd7"
            android:visibility="visible"
            android:clickable="false"
            android:layout_width="50dp"
            android:layout_height="26dp"
            android:checked="false"
            android:button="@null"/>
        <LinearLayout
            android:id="@+id/main_segment_switch"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/main_item_divider_bottom"
        android:background="@color/arg_res_0x7f060d48"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="6dp"/>
</LinearLayout>
