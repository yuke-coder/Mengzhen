<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/arg_res_0x7f060184"
        android:id="@+id/main_tv_speed_cur_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:text="1.0x"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/main_rv_speed_scale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/main_tv_speed_cur_value"/>
    <View
        android:id="@+id/main_ic_speed_left_mask"
        android:background="@drawable/arg_res_0x7f082ccc"
        android:layout_width="105dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/main_rv_speed_scale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/main_rv_speed_scale"/>
    <View
        android:id="@+id/main_ic_speed_right_mask"
        android:background="@drawable/arg_res_0x7f082ccb"
        android:layout_width="105dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/main_rv_speed_scale"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/main_rv_speed_scale"/>
    <ImageView
        android:id="@+id/main_ic_speed_scale_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:src="@drawable/arg_res_0x7f082710"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_tv_speed_cur_value"/>
    <View
        android:id="@+id/main_ic_speed_scale_select_line"
        android:background="@color/arg_res_0x7f060de3"
        android:layout_width="3dp"
        android:layout_height="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/main_ic_speed_scale_top"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/arg_res_0x7f060a5e"
        android:gravity="center"
        android:id="@+id/main_tv_speed_icon_08"
        android:background="@drawable/arg_res_0x7f081edd"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="24dp"
        android:text="0.8"
        android:contentDescription="0.8"
        android:layout_marginStart="20dp"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_rv_speed_scale"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/arg_res_0x7f060a5e"
        android:gravity="center"
        android:id="@+id/main_tv_speed_icon_10"
        android:background="@drawable/arg_res_0x7f081edd"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:text="1.0"
        android:contentDescription="1.0"
        app:layout_constraintEnd_toStartOf="@+id/main_tv_speed_icon_12"
        app:layout_constraintStart_toEndOf="@+id/main_tv_speed_icon_08"
        app:layout_constraintTop_toTopOf="@+id/main_tv_speed_icon_08"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/arg_res_0x7f060a5e"
        android:gravity="center"
        android:id="@+id/main_tv_speed_icon_12"
        android:background="@drawable/arg_res_0x7f081edd"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:text="1.2"
        android:contentDescription="1.2"
        app:layout_constraintEnd_toStartOf="@+id/main_tv_speed_icon_15"
        app:layout_constraintStart_toEndOf="@+id/main_tv_speed_icon_10"
        app:layout_constraintTop_toTopOf="@+id/main_tv_speed_icon_08"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/arg_res_0x7f060a5e"
        android:gravity="center"
        android:id="@+id/main_tv_speed_icon_15"
        android:background="@drawable/arg_res_0x7f081edd"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:text="1.5"
        android:contentDescription="1.5"
        app:layout_constraintEnd_toStartOf="@+id/main_tv_speed_icon_18"
        app:layout_constraintStart_toEndOf="@+id/main_tv_speed_icon_12"
        app:layout_constraintTop_toTopOf="@+id/main_tv_speed_icon_08"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/arg_res_0x7f060a5e"
        android:gravity="center"
        android:id="@+id/main_tv_speed_icon_18"
        android:background="@drawable/arg_res_0x7f081edd"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:text="1.8"
        android:contentDescription="1.8"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/main_tv_speed_icon_08"/>
</androidx.constraintlayout.widget.ConstraintLayout>
