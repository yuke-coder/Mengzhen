<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/main_title_bar"
        layout="@layout/ximalaya_alarm_title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/arg_res_0x7f0702b1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/main_alarm_rl_add_alarm"
        android:background="@drawable/xm_alarm_v9514_0x7f0821e5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:layout_below="@+id/main_title_bar"
        android:backgroundTint="@color/arg_res_0x7f060614">
        <ImageView
            android:id="@+id/main_alarm_iv_add"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/xm_alarm_v9514_0x7f0818aa"
            android:contentDescription="添加定时任务"/>
        <TextView
            android:textColor="@color/xm_alarm_v9514_0x7f060ac8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="添加定时任务"
            android:fontFamily="Regular"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/xm_alarm_v9514_0x7f060c98"
        android:id="@+id/main_alarm_tv_permission"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="-30dp"
        android:text="@string/arg_res_0x7f1204ff"
        android:includeFontPadding="false"
        android:drawableLeft="@drawable/xm_alarm_v9514_0x7f0818ab"
        android:drawablePadding="2dp"
        android:layout_below="@+id/main_alarm_rl_add_alarm"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/xm_alarm_v9514_0x7f060c98"
        android:id="@+id/main_alarm_tv_metion"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-30dp"
        android:layout_marginRight="24dp"
        android:text="打开权限 &gt;"
        android:includeFontPadding="false"
        android:drawablePadding="2dp"
        android:layout_below="@+id/main_alarm_rl_add_alarm"
        android:layout_alignParentRight="true"/>
    <ListView
        android:id="@+id/main_alarm_wakeup_list"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="-20dp"
        android:layout_marginRight="16dp"
        android:cacheColorHint="#00000000"
        android:layout_below="@+id/main_alarm_tv_permission"/>
    <RelativeLayout
        android:id="@+id/main_alarm_no_data_rl"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="130dp"
        android:layout_below="@+id/main_alarm_tv_metion"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/main_alarm_no_data_cat_iv"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/xm_alarm_v9514_0x7f080c61"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/xm_alarm_v9514_0x7f060bbb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="当前没有定时任务"
            android:layout_below="@+id/main_alarm_no_data_cat_iv"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
