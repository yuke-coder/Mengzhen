<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3F4F5">

    <include
        android:id="@+id/main_title_bar"
        layout="@layout/ximalaya_alarm_title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/arg_res_0x7f0702b1"
        android:layout_alignParentTop="true" />

    <ScrollView
        android:id="@+id/main_scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/main_title_bar"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="70dp">

            <TextView
                android:id="@+id/main_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF3F4F5"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="15dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="选择具体场景："
                android:textColor="#FF999999"
                android:textSize="12sp" />

            <com.ximalaya.ting.android.main.view.other.ListViewInScrollView
                android:id="@+id/main_feedback_type_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:fadingEdge="none"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:headerDividersEnabled="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:background="#FFF3F4F5" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="15dp">

                <EditText
                    android:id="@+id/main_et_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/xm_feedback_detail_field"
                    android:gravity="top"
                    android:hint="请输入问题，并留下联系方式，我们会尽快回复"
                    android:includeFontPadding="true"
                    android:maxLength="200"
                    android:minHeight="150dp"
                    android:paddingStart="10dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="46dp"
                    android:textColor="#FF575757"
                    android:textColorHint="#FF999999"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/main_tv_words"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="0 / 200"
                    android:textColor="#FF999999"
                    android:textSize="14sp" />
            </FrameLayout>

            <EditText
                android:id="@+id/main_et_num"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/xm_feedback_detail_field"
                android:ellipsize="end"
                android:gravity="top"
                android:hint="请输入正确的联系方式"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="15dp"
                android:paddingEnd="10dp"
                android:paddingBottom="15dp"
                android:textColor="#FF575757"
                android:textColorHint="#FF999999"
                android:textSize="15sp" />

            <GridView
                android:id="@+id/main_img_gridview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="40dp"
                android:columnWidth="80dp"
                android:horizontalSpacing="10dp"
                android:numColumns="3"
                android:scrollbars="none"
                android:stretchMode="columnWidth"
                android:verticalSpacing="10dp" />

            <ImageView
                android:id="@+id/main_iv_add_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:contentDescription="增加图片"
                android:src="@drawable/xm_feedback_detail_add_image" />

            <TextView
                android:id="@+id/main_feedback_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:text="最多可上传6张图片"
                android:textColor="#FF999999"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/main_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="25dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/xm_feedback_detail_submit"
                android:enabled="false"
                android:gravity="center"
                android:padding="10dp"
                android:text="发送"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
