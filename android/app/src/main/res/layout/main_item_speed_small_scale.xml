<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="22dp"
    android:layout_height="50dp">
    <View
        android:id="@+id/main_view_line"
        android:background="@color/arg_res_0x7f060184"
        android:layout_width="0.5dp"
        android:layout_height="16dp"
        android:layout_marginBottom="5dp"
        android:alpha="0.5"
        app:layout_constraintBottom_toTopOf="@+id/main_tv_item_speed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/arg_res_0x7f060184"
        android:gravity="center"
        android:id="@+id/main_tv_item_speed"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1.0x"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
