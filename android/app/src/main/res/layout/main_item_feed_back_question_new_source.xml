<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFFFF"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/main_iv_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:contentDescription="进入"
        android:src="@drawable/xm_alarm_v9514_0x7f0809d6" />

    <TextView
        android:id="@+id/main_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@id/main_iv_arrow"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:maxEms="8"
        android:singleLine="true"
        android:textColor="#FF999999"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/main_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="15dp"
        android:layout_marginTop="17dp"
        android:layout_marginBottom="17dp"
        android:layout_toStartOf="@id/main_tips"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:textColor="#FF333333"
        android:textSize="16sp" />
</RelativeLayout>
