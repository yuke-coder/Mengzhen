<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/jap"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="46dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/aun"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/grv"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="42dp"
        android:layout_height="50dp"
        android:src="@drawable/playlist_icon_move_new_for_black"
        android:scaleType="fitXY"
        android:contentDescription="@string/qq_playlist_drag_sort"
        android:paddingStart="7dp"
        android:paddingEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/bm7"
        android:focusable="true"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/playlist_icon_delete_new_for_black"
        android:scaleType="fitXY"
        android:contentDescription="@string/qq_playlist_delete"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/grv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="15dp"/>
    <ImageView
        android:id="@+id/ccm"
        android:focusable="true"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/player_popup_play_list_like_black"
        android:scaleType="fitXY"
        android:contentDescription="@string/qq_playlist_favorite"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/bm7"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="15dp"/>
    <ImageView
        android:id="@+id/dzj"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="15dp"
        android:src="@drawable/icon_play_next_for_cell"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ccm"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/am3"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="15dp"
        android:src="@drawable/playlist_icon_paper_clip"
        android:contentDescription="@string/qq_playlist_source"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/dzj"
        app:layout_constraintTop_toTopOf="parent"/>
    <org.libpag.PAGView
        android:id="@+id/dzl"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="11dp"
        android:layout_marginRight="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/am3"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/fdk"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/dzl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15dp"
            android:textColor="@color/skin_text_main_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/kd_"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/k31"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/skin_text_sub_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/k31"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/lzc"
            app:layout_constraintStart_toEndOf="@+id/kd_"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="9dp"
            android:textColor="@color/skin_text_sub_color"
            android:gravity="center"
            android:id="@+id/lzc"
            android:background="@drawable/bg_common_song_list_quality_tag_gray"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ndj"
            app:layout_constraintStart_toEndOf="@+id/k31"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="9dp"
            android:textColor="@color/common_song_list_tag_text_green"
            android:gravity="center"
            android:id="@+id/ndj"
            android:background="@drawable/common_song_list_icon_green_bg"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/fsd"
            app:layout_constraintStart_toEndOf="@+id/lzc"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="9dp"
            android:textColor="@color/common_song_list_tag_text_green"
            android:gravity="center"
            android:id="@+id/fsd"
            android:background="@drawable/common_song_list_icon_green_bg"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/qq_playlist_quality"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/euz"
            app:layout_constraintStart_toEndOf="@+id/ndj"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/euz"
            android:background="@drawable/bg_common_song_list_quality_tag_gray"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginLeft="4dp">
            <ImageView
                android:id="@+id/dn0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:src="@drawable/song_play_device_icon_phone"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="9dp"
            android:textColor="@color/skin_text_sub_color"
            android:gravity="center"
            android:id="@+id/l83"
            android:background="@drawable/bg_common_song_list_quality_tag_gray"
            android:paddingLeft="2dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginLeft="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/dzl"
            app:layout_constraintStart_toEndOf="@+id/euz"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
