<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_cl_main_content"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <FrameLayout
            android:id="@+id/main_sound_effect_guidance_info_bar_container"
            android:background="@drawable/arg_res_0x7f081ac5"
            android:paddingBottom="22dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="72dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/main_sound_effect_count_down"
                android:paddingLeft="@dimen/arg_res_0x7f0700f1"
                android:paddingRight="@dimen/arg_res_0x7f0700f1"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/main_iv_sound_effect_bar_label"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginRight="2dp"
                    android:scaleType="fitCenter"/>
                <View
                    android:id="@+id/main_iv_split"
                    android:background="#fff3a686"
                    android:layout_width="0.5dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/arg_res_0x7f060270"
                    android:id="@+id/main_tv_normal"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="开通会员畅享全部音质音效"
                    android:lines="1"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14sp"
                    android:textColor="@color/arg_res_0x7f060270"
                    android:id="@+id/main_tv_time_limit"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="会员音质&amp;音效体验剩余: 1天23时"
                    android:lines="1"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#732f06"
                    android:gravity="center"
                    android:id="@+id/main_tv_action"
                    android:background="@drawable/arg_res_0x7f081e08"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginLeft="8dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </FrameLayout>
        <View
            android:id="@+id/main_view_guide"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="50dp"
            app:layout_constraintTop_toTopOf="@+id/main_sound_effect_guidance_info_bar_container"
            app:layout_goneMarginTop="0dp"/>
        <com.ximalaya.ting.android.main.playpage.view.PlayListPagerSlidingTabStrip
            android:textSize="15sp"
            android:id="@+id/main_play_tabs"
            android:background="@drawable/arg_res_0x7f081ac7"
            android:fadingEdgeLength="0dp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:overScrollMode="never"
            app:layout_constraintTop_toTopOf="@+id/main_view_guide"
            app:pstsActivateTextColor="@color/arg_res_0x7f06062e"
            app:pstsDeactivateTextColor="@color/arg_res_0x7f060ae9"
            app:pstsDividerPadding="0dp"
            app:pstsIndicatorColor="@color/arg_res_0x7f060646"
            app:pstsIndicatorCornerRadius="1dp"
            app:pstsIndicatorHeight="3dp"
            app:pstsIndicatorWidth="24dp"
            app:pstsRedDotAutoDismiss="false"
            app:pstsRedDotColor="@color/arg_res_0x7f060e67"
            app:pstsRedDotEnable="true"
            app:pstsRedDotHintLeftRightPadding="5dp"
            app:pstsRedDotHintLightBold="true"
            app:pstsRedDotHintPadding="3.5dp"
            app:pstsRedDotHintTextSize="11sp"
            app:pstsRedDotLeftMargin="-2dp"
            app:pstsRedDotSize="7dp"
            app:pstsRedDotStrokeColor="@color/arg_res_0x7f060646"
            app:pstsRedDotStrokeSize="1dp"
            app:pstsRedDotTopMargin="12dp"
            app:pstsShouldExpand="false"
            app:pstsSmoothScroll="false"
            app:pstsTabPaddingLeftRight="16dp"
            app:pstsUnderlineColor="@color/arg_res_0x7f06080a"
            app:pstsUnderlineHeight="10dp"
            style="@style/arg_res_0x7f1303b6"/>
        <ImageView
            android:id="@+id/main_close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/arg_res_0x7f08285b"
            android:tint="@color/arg_res_0x7f060326"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/main_play_tabs"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/main_play_tabs"
            app:layout_goneMarginTop="20dp"/>
        <com.ximalaya.ting.android.host.view.other.MyViewPager
            android:id="@+id/main_play_viewpager"
            android:background="@color/arg_res_0x7f060521"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/main_play_tabs"
            app:layout_goneMarginTop="20dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/main_whole_mask"
        android:background="#33000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
