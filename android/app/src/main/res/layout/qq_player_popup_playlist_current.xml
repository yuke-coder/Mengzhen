<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:background="@color/as_background_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lzb"
        android:background="@drawable/player_popup_playlist_try_2_play_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="37dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="13sp"
            android:textColor="@color/skin_text_main_color"
            android:id="@+id/hsv"
            android:fadingEdge="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scrollHorizontally="true"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/hsu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hsu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="13dp"
                android:textColor="@color/skin_text_main_color"
                android:ellipsize="end"
                android:id="@+id/hss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qq_playlist_try_play"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/hst"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/hst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/player_popup_try_2_play_arrow_for_black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/e_"
        android:background="@drawable/transparent"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginLeft="16dp"
        android:src="@drawable/play_mode_normal"
        android:scaleType="fitCenter"
        android:layout_alignParentLeft="true"
        app:layout_constraintBottom_toBottomOf="@+id/hzf"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/hzf"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="13dp"
        android:textColor="@color/skin_text_sub_color"
        android:ellipsize="end"
        android:id="@+id/hzf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:singleLine="true"
        app:layout_constraintLeft_toRightOf="@+id/e_"
        app:layout_constraintTop_toBottomOf="@+id/lzb"
        app:layout_goneMarginTop="17dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hzh"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:contentDescription="@string/qq_playlist_shuffle_adjust"
        app:layout_constraintBottom_toBottomOf="@+id/hzf"
        app:layout_constraintLeft_toRightOf="@+id/hzf"
        app:layout_constraintTop_toTopOf="@+id/hzf">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="13dp"
            android:textColor="@color/skin_text_sub_color"
            android:ellipsize="end"
            android:id="@+id/hzi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/hzg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:src="@drawable/random_play_adjust_arrow"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/hzi"
            app:layout_constraintLeft_toRightOf="@+id/hzi"
            app:layout_constraintTop_toTopOf="@+id/hzi"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hzk"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/qq_playlist_history"
        android:layout_marginStart="9dp"
        app:layout_constraintBottom_toBottomOf="@+id/hzf"
        app:layout_constraintStart_toEndOf="@+id/hzh"
        app:layout_constraintTop_toTopOf="@+id/hzf">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="13dp"
            android:textColor="@color/skin_text_sub_color"
            android:ellipsize="end"
            android:id="@+id/hzl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qq_playlist_history"
            android:singleLine="true"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/hzj"
            app:layout_constraintRight_toLeftOf="@+id/hzj"
            app:layout_constraintTop_toTopOf="@+id/hzj"/>
        <ImageView
            android:id="@+id/hzj"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:src="@drawable/arrow_right_grey"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/hyv"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="14dp"
        android:src="@drawable/playlist_icon_download_new_for_black"
        android:scaleType="fitCenter"
        android:layout_toLeftOf="@+id/hyt"
        android:contentDescription="@string/qq_playlist_download"
        app:layout_constraintBottom_toBottomOf="@+id/hzf"
        app:layout_constraintRight_toLeftOf="@+id/hyt"
        app:layout_constraintTop_toTopOf="@+id/hzf"/>
    <ImageView
        android:id="@+id/hyt"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="14dp"
        android:src="@drawable/playlist_icon_add_to_new_for_black"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:contentDescription="@string/qq_playlist_add"
        app:layout_constraintBottom_toBottomOf="@+id/hzf"
        app:layout_constraintRight_toLeftOf="@+id/hyu"
        app:layout_constraintTop_toTopOf="@+id/hzf"/>
    <ImageView
        android:id="@+id/hyu"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/playlist_icon_garbage_new_for_black"
        android:scaleType="fitCenter"
        android:contentDescription="@string/qq_playlist_clear"
        app:layout_constraintBottom_toBottomOf="@+id/hzf"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/hzf"/>
    <FrameLayout
        android:id="@+id/cgv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="5dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hzf">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hz6"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:overScrollMode="never"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/f2t"
        android:background="@color/as_background_dark"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        app:layout_constraintTop_toBottomOf="@+id/hzf"/>
</androidx.constraintlayout.widget.ConstraintLayout>
