<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.tencent.qqmusic.ui.RoundedConstraintLayout
        android:id="@+id/xg"
        android:background="@color/white"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        app:constraintLayout_radiusNew="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/xj"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/common_dialog_text_normal_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/xh"
            android:paddingLeft="10dp"
            android:paddingTop="12dp"
            android:paddingRight="10dp"
            android:paddingBottom="0dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="提示"
            android:maxLines="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/xj"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/a_z"
            android:paddingBottom="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="30dp"
            app:layout_constraintBottom_toTopOf="@+id/alk"
            app:layout_constraintTop_toBottomOf="@+id/xh">
            <androidx.appcompat.widget.AppCompatTextView
                android:scrollbarTrackVertical="@drawable/scrollbar_song_recommend"
                android:scrollbarStyle="outsideOverlay"
                android:textSize="14dp"
                android:textColor="@color/common_dialog_text_normal_color"
                android:textColorLink="@color/skin_highlight_color"
                android:gravity="left"
                android:id="@+id/content"
                android:background="@null"
                android:paddingTop="0dp"
                android:focusable="false"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="false"
                android:lineHeight="18dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/awy"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/content">
                <CheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/awl"
                    android:background="@drawable/dialog_edit_checkbox"
                    android:focusableInTouchMode="false"
                    android:visibility="visible"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:checked="false"
                    android:button="@null"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/common_dialog_text_sub_color"
                    android:gravity="center_vertical"
                    android:id="@+id/awm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/alk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <include
                android:id="@+id/alm"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="30.5dp"
                android:layout_marginBottom="0.5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                layout="@layout/qq_music_dialog_buttons"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.tencent.qqmusic.ui.RoundedConstraintLayout>
    <ImageView
        android:id="@+id/close_btn"
        android:background="@drawable/dialog_fragment_btn_close"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="30dp"
        android:contentDescription="@string/qq_dialog_close"
        app:layout_constraintLeft_toLeftOf="@+id/xg"
        app:layout_constraintRight_toRightOf="@+id/xg"
        app:layout_constraintTop_toBottomOf="@+id/xg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
