<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:background="@color/as_background_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/skin_text_main_color"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/ice"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="150dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="13dp"
        android:textColor="@color/skin_text_main_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/ica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/ice"
        app:layout_constraintStart_toEndOf="@+id/ice"
        app:layout_constraintTop_toTopOf="@+id/ice"/>
    <ImageView
        android:id="@+id/icd"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/playlist_icon_paper_clip_new_for_black"
        android:contentDescription="@string/qq_playlist_source"
        app:layout_constraintBottom_toBottomOf="@+id/ice"
        app:layout_constraintStart_toEndOf="@+id/ica"
        app:layout_constraintTop_toTopOf="@+id/ice"/>
    <ImageView
        android:id="@+id/icb"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="14dp"
        android:src="@drawable/playlist_icon_download_new_for_black"
        android:scaleType="fitCenter"
        android:contentDescription="@string/qq_playlist_download"
        app:layout_constraintBottom_toBottomOf="@+id/ice"
        app:layout_constraintRight_toLeftOf="@+id/ic9"
        app:layout_constraintTop_toTopOf="@+id/ice"/>
    <ImageView
        android:id="@+id/ic9"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="14dp"
        android:src="@drawable/playlist_icon_add_to_new_for_black"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:contentDescription="@string/qq_playlist_add"
        app:layout_constraintBottom_toBottomOf="@+id/ice"
        app:layout_constraintRight_toLeftOf="@+id/ic_"
        app:layout_constraintTop_toTopOf="@+id/ice"/>
    <ImageView
        android:id="@+id/ic_"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/playlist_icon_garbage_new_for_black"
        android:scaleType="fitCenter"
        android:contentDescription="@string/qq_playlist_clear"
        app:layout_constraintBottom_toBottomOf="@+id/ice"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ice"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/icc"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="@null"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ice"/>
    <FrameLayout
        android:id="@+id/f2t"
        android:background="@color/as_background_dark"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        app:layout_constraintTop_toBottomOf="@+id/ice"/>
</androidx.constraintlayout.widget.ConstraintLayout>
