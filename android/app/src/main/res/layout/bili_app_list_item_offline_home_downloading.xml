<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/item_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/section_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="正在缓存"
        android:textColor="@color/Ga10"
        android:textSize="@dimen/text_size_headline"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:tint="@color/Ga4"
        app:layout_constraintBottom_toBottomOf="@id/section_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/section_title"
        app:srcCompat="@drawable/ic_vector_general_enter_big" />

    <ImageView
        android:id="@+id/cover_shadow"
        android:layout_width="128dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:adjustViewBounds="true"
        android:src="@drawable/ic_offline_folder"
        app:layout_constraintLeft_toLeftOf="@id/cover"
        app:layout_constraintRight_toRightOf="@id/cover"
        app:layout_constraintTop_toBottomOf="@id/section_title" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cover"
        android:layout_width="128dp"
        android:layout_height="72dp"
        android:background="@drawable/shape_roundrect_4_black_alpha50"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/space"
        app:layout_constraintTop_toBottomOf="@id/cover_shadow" />

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/shape_roundrect_4_black_alpha50"
        app:layout_constraintBottom_toBottomOf="@id/cover"
        app:layout_constraintLeft_toLeftOf="@id/cover"
        app:layout_constraintRight_toRightOf="@id/cover"
        app:layout_constraintTop_toTopOf="@id/cover">

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/Wh0_u"
            android:textSize="@dimen/text_size_body_secondary" />
    </FrameLayout>

    <View
        android:id="@+id/space"
        android:layout_width="10dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toRightOf="@id/cover"
        app:layout_constraintRight_toLeftOf="@id/title" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/Ga10"
        android:textSize="@dimen/text_size_subtitle"
        app:layout_constraintLeft_toRightOf="@id/space"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/cover_shadow" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/Ga10"
        android:textSize="@dimen/text_size_subtitle"
        app:layout_constraintLeft_toRightOf="@id/space"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <TextView
        android:id="@+id/tip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:gravity="left"
        android:maxLines="1"
        android:textColor="@color/Ga5"
        android:textSize="@dimen/text_size_body_secondary"
        app:layout_constraintBottom_toTopOf="@id/progress"
        app:layout_constraintLeft_toRightOf="@id/space"
        app:layout_constraintRight_toLeftOf="@id/total_size" />

    <TextView
        android:id="@+id/total_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/Ga5"
        android:textSize="@dimen/text_size_body_secondary"
        app:layout_constraintBottom_toTopOf="@id/progress"
        app:layout_constraintLeft_toRightOf="@id/tip"
        app:layout_constraintRight_toRightOf="parent" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/theme_color_secondary"
        android:progressTint="@color/theme_color_secondary"
        app:layout_constraintBottom_toBottomOf="@id/cover"
        app:layout_constraintLeft_toRightOf="@id/space"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
