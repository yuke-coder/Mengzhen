<?xml version="1.0" encoding="utf-8"?>
<com.sankuai.waimai.store.shimmer.SGShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skeleton_shimmer_wrapper"
    android:background="#f5f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shimmer_base_alpha="0.5"
    app:shimmer_direction="left_to_right"
    app:shimmer_duration="1000"
    app:shimmer_highlight_alpha="1">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <View
                android:background="@drawable/wm_sc_skeleton_rounded_bg_large"
                android:layout_width="match_parent"
                android:layout_height="77dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/skeleton_filter_container"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/skeleton_list_container"
            android:paddingTop="0dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"/>
    </LinearLayout>
</com.sankuai.waimai.store.shimmer.SGShimmerFrameLayout>
