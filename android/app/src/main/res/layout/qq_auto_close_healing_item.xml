<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/qq_healing_cover"
        android:layout_width="136dp"
        android:layout_height="136dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/qq_healing_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="75dp"
        android:textColor="@android:color/white"
        android:textSize="27sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/qq_healing_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/qq_healing_white_60"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/qq_healing_title"
        app:layout_constraintTop_toBottomOf="@id/qq_healing_title" />

    <View
        android:id="@+id/qq_healing_bottom"
        android:layout_width="136dp"
        android:layout_height="45dp"
        android:background="@drawable/qq_auto_close_healing_bottom"
        app:layout_constraintBottom_toBottomOf="@id/qq_healing_cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/qq_healing_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="30分钟"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/qq_healing_bottom"
        app:layout_constraintStart_toStartOf="@id/qq_healing_title"
        app:layout_constraintTop_toTopOf="@id/qq_healing_bottom" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/qq_auto_close_healing_play_icon"
        app:layout_constraintBottom_toBottomOf="@id/qq_healing_bottom"
        app:layout_constraintEnd_toEndOf="@id/qq_healing_bottom"
        app:layout_constraintTop_toTopOf="@id/qq_healing_bottom" />

</androidx.constraintlayout.widget.ConstraintLayout>
