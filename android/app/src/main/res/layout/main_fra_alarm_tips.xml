<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/main_tips_bg"
        android:paddingLeft="0dp"
        android:paddingTop="0dp"
        android:paddingRight="0dp"
        android:paddingBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:backgroundTint="@color/xm_alarm_v9514_0x7f060a43"
        app:cornerRadius="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/main_alarm_tip_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/main_alarm_tip_1"
        style="@style/arg_res_0x7f1303b5"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/main_alarm_tip_1"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="优化提示"
        android:color="@color/arg_res_0x7f06060f"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/main_tips_bg"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:ellipsize="end"
        android:id="@+id/main_alarm_tip_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="为保证正常使用 请不要退出梦枕"
        android:maxLines="1"
        android:color="@color/arg_res_0x7f06060f"
        android:alpha="0.6"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/main_alarm_tip_1"
        app:layout_constraintEnd_toStartOf="@+id/main_derivative_more"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/main_alarm_tip_1"
        app:layout_constraintTop_toTopOf="@+id/main_alarm_tip_1"/>
    <View
        android:id="@+id/main_derivative_more"
        android:background="@drawable/xm_alarm_v9514_0x7f0818b3"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/main_alarm_tip_1"
        app:layout_constraintEnd_toEndOf="@+id/main_tips_bg"
        app:layout_constraintTop_toTopOf="@+id/main_alarm_tip_1"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/main_alarm_tip_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="为保证正常使用，请注意："
        android:color="@color/arg_res_0x7f060262"
        app:layout_constraintStart_toStartOf="@+id/main_tips_bg"
        app:layout_constraintTop_toBottomOf="@+id/main_tips_bg"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/main_alarm_tip_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="1.退出梦枕APP时，无法响铃\n2.关机、打开手机静音开关、音量为0，处于勿扰模式、省电模式时，都将无法响铃\n3.插入耳机时，闹钟仅能在耳机中播放\n4.电话通话时，也将正常响铃\n5.Android10 以上设备需要开启悬浮窗权限"
        android:color="#9e9e9e"
        app:layout_constraintStart_toStartOf="@+id/main_alarm_tip_3"
        app:layout_constraintTop_toBottomOf="@+id/main_alarm_tip_3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
