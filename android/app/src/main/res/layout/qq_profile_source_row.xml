<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginTop="15dp">
    <TextView
        android:id="@+id/qq_profile_row_label"
        android:textSize="16sp"
        android:textColor="@color/qq_profile_skin_text_main_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true" />
    <TextView
        android:id="@+id/qq_profile_row_value"
        android:textSize="14sp"
        android:textColor="@color/qq_profile_skin_text_sub_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="15dp"
        android:layout_toLeftOf="@id/qq_profile_row_arrow"
        android:layout_centerVertical="true" />
    <ImageView
        android:id="@+id/qq_profile_row_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="14dp"
        android:src="@drawable/arrow_right_grey"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true" />
</RelativeLayout>
