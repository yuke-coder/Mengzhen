<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/jaq"
    android:background="#1a1a1a"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:state_window_focused="false"
        android:id="@+id/lsw"
        android:paddingTop="0dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/lst"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="2dp">
            <ImageView
                android:id="@+id/dt_"
                android:background="@null"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/back_player_defined"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                android:contentDescription="@string/qq_style_editor_back"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="18dp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/mm8"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="54dp"
                android:layout_marginRight="96dp"
                android:text="编辑细节"
                android:maxLines="1"
                android:layout_alignParentTop="true"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/ake"
                android:paddingLeft="6.5dp"
                android:paddingRight="6.5dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="投稿"
                android:layout_toLeftOf="@+id/akk"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#000000"
                android:id="@+id/akk"
                android:background="@drawable/btn_player_style_use_shape"
                android:paddingTop="6.5dp"
                android:paddingBottom="6.5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:text="使用"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </RelativeLayout>
    </RelativeLayout>
    <com.tencent.qqmusic.ui.RoundedConstraintLayout
        android:id="@+id/n7g"
        android:layout_width="match_parent"
        android:layout_height="445dp"
        android:layout_marginTop="18dp"
        app:constraintLayout_radiusNew="12.5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lsw">
        <FrameLayout
            android:id="@+id/n7f"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/njr"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.tencent.qqmusic.ui.RoundedConstraintLayout>
    <ImageView
        android:id="@+id/ak0"
        android:layout_width="64dp"
        android:layout_height="21dp"
        android:layout_marginTop="15dp"
        android:src="@drawable/icon_player_style_reset"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/n7g"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/eu_"
        android:background="#1a1a1a"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/n7g"
        app:layout_constraintLeft_toLeftOf="@+id/n7g"
        app:layout_constraintRight_toRightOf="@+id/n7g"
        app:layout_constraintTop_toTopOf="@+id/n7g">
        <View
            android:id="@+id/fh6"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/ci4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ak0"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/iqz"
        android:background="#1a1a1a"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ak0"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cxo"
        android:background="#1f1f1f"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <org.libpag.PAGView
            android:id="@+id/cxn"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/cxp"
        android:background="#1f1f1f"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.4"/>
    <FrameLayout
        android:id="@+id/c16"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
