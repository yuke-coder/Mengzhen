<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:clipChildren="false"
        android:layout_width="54dp"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/main_pay_more_action_head_iv"
            android:background="@drawable/arg_res_0x7f081da2"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="3dp"
            android:scaleType="center"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/arg_res_0x7f060645"
            android:layout_gravity="right"
            android:id="@+id/main_red_tag_tv"
            android:background="@drawable/arg_res_0x7f081c78"
            android:paddingLeft="1dp"
            android:paddingRight="3dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="-9dp"/>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/arg_res_0x7f060626"
        android:layout_gravity="center_horizontal"
        android:id="@+id/main_pay_more_action_head_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"/>
</LinearLayout>
