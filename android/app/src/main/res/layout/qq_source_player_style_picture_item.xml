<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/evw"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.tencent.qqmusic.ui.RoundedConstraintLayout
        android:id="@+id/euv"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraintLayout_radiusNew="4dp"
        app:layout_constraintBottom_toTopOf="@+id/moh"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/dr4"
            android:layout_width="154dp"
            android:layout_height="88dp"/>
    </com.tencent.qqmusic.ui.RoundedConstraintLayout>
    <ImageView
        android:id="@+id/ds0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/defined_player_edit_selected"
        app:layout_constraintBottom_toBottomOf="@+id/euv"
        app:layout_constraintLeft_toLeftOf="@+id/euv"
        app:layout_constraintRight_toRightOf="@+id/euv"
        app:layout_constraintTop_toTopOf="@+id/euv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dr3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="10dp"
        app:layout_constraintDimensionRatio="w,1:1"
        app:layout_constraintEnd_toEndOf="@+id/euv"
        app:layout_constraintTop_toTopOf="@+id/euv"
        app:layout_constraintWidth_percent="0.21"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/moh"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="23dp"
        android:text=""
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="@+id/euv"
        app:layout_constraintRight_toRightOf="@+id/euv"
        app:layout_constraintTop_toBottomOf="@+id/euv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
