<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_list_bottom_sheet_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/l1g"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bej"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/black_50_opacity"
                android:id="@+id/bel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qq_playlist_now_playing"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/bem"
                android:focusable="true"
                android:visibility="visible"
                android:clickable="true"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/playlist_icon_play_list_source"
                android:contentDescription="@string/qq_playlist_source"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/bel"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/black_50_opacity"
                android:id="@+id/bei"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/bem"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="4dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/iso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/icg"
            app:layout_constraintStart_toEndOf="@+id/bej"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/black_50_opacity"
                android:id="@+id/isz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qq_playlist_played_songs"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/black_50_opacity"
                android:id="@+id/isb"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/isz"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/icg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/black_50_opacity"
                android:id="@+id/ich"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qq_playlist_played_lists"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/black_50_opacity"
                android:id="@+id/icf"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ich"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/hla"
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/player_popup_indicator_round_bg"
            app:layout_constraintStart_toStartOf="@+id/bej"
            app:layout_constraintTop_toBottomOf="@+id/bej"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.viewpager.widget.ViewPager
        android:layout_gravity="center_horizontal"
        android:id="@+id/hzo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/l1g"/>
    <FrameLayout
        android:id="@+id/n8o"
        android:background="@color/as_background_dark"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_below="@+id/l1g"/>
    <ImageView
        android:id="@+id/e9y"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="84dp"
        android:layout_marginBottom="60dp"
        android:src="@drawable/anchor_in_cell_for_play_list"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:contentDescription="@string/qq_playlist_current_position"/>
</RelativeLayout>
