<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/arg_res_0x7f070385"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/main_play_more_action_ll_header_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/arg_res_0x7f0700f1"
            android:layout_marginRight="@dimen/arg_res_0x7f0700f1">
            <com.ximalaya.ting.android.framework.view.image.RoundImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/main_iv_album_cover"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="@dimen/arg_res_0x7f0703c7"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="@dimen/arg_res_0x7f0703c7"
                android:src="@drawable/arg_res_0x7f0807c8"
                android:scaleType="centerCrop"
                android:contentDescription="@string/arg_res_0x7f120509"
                app:corner_radius="4dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/arg_res_0x7f060ac3"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="专辑："
                android:lines="1"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/arg_res_0x7f060ac3"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/main_play_more_action_lv_header_track_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:lines="1"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@drawable/arg_res_0x7f082d58"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/main_play_more_action_lv_header_track_subscribe_tv"
                android:background="@drawable/arg_res_0x7f082c7b"
                android:paddingLeft="5dp"
                android:paddingRight="7dp"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/main_play_more_action_ll_header_anchor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/arg_res_0x7f0700f1"
            android:layout_marginEnd="@dimen/arg_res_0x7f0700f1">
            <com.ximalaya.ting.android.framework.view.image.RoundImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/main_play_more_action_lv_header_anchor_iv"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="@dimen/arg_res_0x7f0703c7"
                android:layout_marginBottom="@dimen/arg_res_0x7f0703c7"
                android:scaleType="centerCrop"
                android:layout_marginEnd="16dp"
                app:corner_radius="12dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/arg_res_0x7f060ac3"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="主播："
                android:lines="1"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/arg_res_0x7f060ac3"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/main_play_more_action_lv_header_anchor_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:lines="1"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@drawable/arg_res_0x7f082d58"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/main_play_more_action_lv_header_anchor_follow_tv"
                android:background="@drawable/arg_res_0x7f082c7b"
                android:paddingLeft="5dp"
                android:paddingRight="7dp"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/main_play_more_action_lv_header_shopping_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/arg_res_0x7f0700f1"
            android:layout_marginRight="@dimen/arg_res_0x7f0700f1">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="@dimen/arg_res_0x7f0703c7"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="@dimen/arg_res_0x7f0703c7"
                android:src="@drawable/arg_res_0x7f082a91"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/arg_res_0x7f060ac3"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:text="TA的店铺"
                android:lines="1"
                android:layout_weight="1"/>
            <com.ximalaya.ting.android.framework.view.image.RoundImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/main_play_more_action_lv_header_shopping_iv"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="11dp"
                app:corner_radius="4dp"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/arg_res_0x7f060b86"
                android:layout_gravity="center_vertical"
                android:id="@+id/main_play_more_action_lv_header_shopping_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="14dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/main_ll_ad_sound_patch_more"
            android:paddingLeft="@dimen/arg_res_0x7f0700f1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="bottom"
                android:background="@color/arg_res_0x7f060d1e"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="32dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginTop="@dimen/arg_res_0x7f070385"
                    android:layout_marginRight="12dp"
                    android:layout_marginBottom="@dimen/arg_res_0x7f070436"
                    android:src="@drawable/arg_res_0x7f082a88"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/arg_res_0x7f060ac3"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:text="您刚刚听过的音频推荐"
                    android:lines="1"
                    android:layout_weight="1"/>
            </LinearLayout>
            <com.ximalaya.ting.android.main.view.RecyclerViewNoFocus
                android:id="@+id/main_rlv_ad_more_layout"
                android:background="@color/arg_res_0x7f0611fa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginBottom="@dimen/arg_res_0x7f07039b"/>
        </LinearLayout>
        <View
            android:background="@color/arg_res_0x7f060d43"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/arg_res_0x7f070420"/>
    </LinearLayout>
</FrameLayout>
