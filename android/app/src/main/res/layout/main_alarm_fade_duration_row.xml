<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/xm_alarm_v9514_0x7f060e75"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/main_alarm_fade_label"
        android:textSize="14sp"
        android:textColor="@color/arg_res_0x7f060b3b"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/main_alarm_fade_value"
        android:textSize="14sp"
        android:textColor="@color/arg_res_0x7f060b3b"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_toRightOf="@id/main_alarm_fade_label"
        android:layout_alignTop="@id/main_alarm_fade_label" />

    <TextView
        android:id="@+id/main_alarm_fade_unit"
        android:textSize="14sp"
        android:textColor="@color/arg_res_0x7f060b3b"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_toRightOf="@id/main_alarm_fade_value"
        android:layout_alignTop="@id/main_alarm_fade_value" />

    <SeekBar
        android:id="@+id/main_alarm_fade_seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="8dp"
        android:maxHeight="15dp"
        android:minHeight="15dp"
        android:max="120"
        android:progress="0"
        android:progressDrawable="@drawable/arg_res_0x7f082c6e"
        android:thumb="@drawable/arg_res_0x7f082c6d"
        android:layout_below="@id/main_alarm_fade_value"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

</RelativeLayout>
