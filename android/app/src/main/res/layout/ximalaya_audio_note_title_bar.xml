<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xm_audio_note_title_surface">

    <TextView
        android:id="@+id/ximalaya_title_cancel"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:gravity="center"
        android:text="取消"
        android:textColor="@color/xm_audio_note_primary_text"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/ximalaya_title_back"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:contentDescription="返回"
        android:scaleType="centerInside"
        android:src="@drawable/arg_res_0x7f080ab2"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ximalaya_title_text"
        android:layout_width="180dp"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:singleLine="true"
        android:text="编辑备注"
        android:textColor="@color/xm_audio_note_primary_text"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/ximalaya_title_right"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:gravity="center"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:text="保存"
        android:textColor="@color/xm_audio_note_primary_text"
        android:textSize="14sp" />
</RelativeLayout>
