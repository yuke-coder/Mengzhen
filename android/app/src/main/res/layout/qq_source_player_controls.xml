<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adk"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/iod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.176"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/ioc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.824"/>
    <FrameLayout
        android:id="@+id/ac7"
        android:tag="@string/qq_source_player_playlist"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/adx"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toStartOf="@+id/ad1"
        app:layout_constraintHeight_percent="0.666"
        app:layout_constraintStart_toEndOf="@+id/ddq"
        app:layout_constraintTop_toTopOf="@+id/adx"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/ad2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.064"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/ad1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.936"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ae2"
        android:tag="@string/qq_source_player_next"
        android:background="@null"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/qq_source_player_next"
        app:layout_constraintBottom_toBottomOf="@+id/adx"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toStartOf="@+id/ddo"
        app:layout_constraintHeight_percent="0.666"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/ddn"
        app:layout_constraintTop_toTopOf="@+id/adx"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/adw"
        android:tag="@string/qq_source_player_previous"
        android:background="@null"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/qq_source_player_previous"
        app:layout_constraintBottom_toBottomOf="@+id/adx"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toStartOf="@+id/ddq"
        app:layout_constraintHeight_percent="0.666"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/ddp"
        app:layout_constraintTop_toTopOf="@+id/adx"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/adx"
        android:tag="@string/qq_source_player_play_pause"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toStartOf="@+id/ddp"
        app:layout_constraintHeight_percent="0.9999"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/ddo"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/adu"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/adv"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.7"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Space
        android:id="@+id/abu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,23:15"
        app:layout_constraintEnd_toEndOf="@+id/abt"
        app:layout_constraintTop_toTopOf="@+id/abt"
        app:layout_constraintWidth_percent="0.022"/>
    <TextView
        android:textSize="9dp"
        android:textStyle="bold"
        android:textColor="#99ffffff"
        android:ellipsize="none"
        android:id="@+id/ac2"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/abt"
        app:layout_constraintEnd_toEndOf="@+id/abt"
        app:layout_constraintStart_toStartOf="@+id/abt"
        app:layout_constraintTop_toTopOf="@+id/abt"/>
    <FrameLayout
        android:id="@+id/abt"
        android:tag="@string/qq_source_player_mode"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/adx"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toStartOf="@+id/ddn"
        app:layout_constraintHeight_percent="0.666"
        app:layout_constraintStart_toStartOf="@+id/ad2"
        app:layout_constraintTop_toTopOf="@+id/adx"/>
    <Space
        android:id="@+id/ddn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/adx"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toStartOf="@+id/ae2"
        app:layout_constraintHorizontal_weight="25"
        app:layout_constraintStart_toEndOf="@+id/abt"
        app:layout_constraintTop_toTopOf="@+id/adx"/>
    <Space
        android:id="@+id/ddo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/adx"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toStartOf="@+id/adx"
        app:layout_constraintHorizontal_weight="30"
        app:layout_constraintStart_toEndOf="@+id/ae2"
        app:layout_constraintTop_toTopOf="@+id/adx"/>
    <Space
        android:id="@+id/ddp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/adx"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toStartOf="@+id/adw"
        app:layout_constraintHorizontal_weight="30"
        app:layout_constraintStart_toEndOf="@+id/adx"
        app:layout_constraintTop_toTopOf="@+id/adx"/>
    <Space
        android:id="@+id/ddq"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/adx"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toStartOf="@+id/ac7"
        app:layout_constraintHorizontal_weight="25"
        app:layout_constraintStart_toEndOf="@+id/adw"
        app:layout_constraintTop_toTopOf="@+id/adx"/>
</androidx.constraintlayout.widget.ConstraintLayout>
