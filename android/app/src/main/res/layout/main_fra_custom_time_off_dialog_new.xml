<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/xm_alarm_v9514_0x7f082d7f"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/xm_alarm_v9514_0x7f0601c8"
        android:gravity="start|center_vertical"
        android:id="@+id/main_tv_title"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="自定义关闭"
        android:fontFamily="sans-serif-light"
        android:paddingStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/main_iv_close"
        android:padding="5dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/xm_alarm_v9514_0x7f0825b3"
        android:scaleType="fitXY"
        android:tint="@color/xm_alarm_v9514_0x7f0602b4"
        android:layout_marginEnd="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/main_tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/main_tv_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_picker_layout"
        android:background="@drawable/xm_alarm_v9514_0x7f081e1c"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="262dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_tv_title">
        <View
            android:background="@drawable/xm_alarm_v9514_0x7f081835"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@color/xm_alarm_v9514_0x7f060cb1"
            android:layout_width="1px"
            android:layout_height="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.ximalaya.ting.android.main.view.NumberPickerView
            android:id="@+id/main_picker_hour"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/main_picker_minute"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:npv_ItemPaddingHorizontal="0dp"
            app:npv_ItemPaddingVertical="10dp"
            app:npv_RespondChangeOnDetached="false"
            app:npv_ShowDivider="false"
            app:npv_ShownCount="5"
            app:npv_TextArray="@array/arg_res_0x7f03000c"
            app:npv_TextColorNormal="@color/xm_alarm_v9514_0x7f060cbe"
            app:npv_TextColorSelected="@color/xm_alarm_v9514_0x7f060a5e"
            app:npv_TextSizeNormal="22sp"
            app:npv_TextSizeSelected="22sp"
            app:npv_WrapSelectorWheel="true"/>
        <TextView
            android:id="@+id/main_picker_hour_unit"
            android:textSize="14sp"
            android:textColor="@color/xm_alarm_v9514_0x7f0601d6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="小时"
            app:layout_constraintBottom_toBottomOf="@+id/main_picker_hour"
            app:layout_constraintStart_toEndOf="@+id/main_picker_hour"
            app:layout_constraintTop_toTopOf="@+id/main_picker_hour"/>
        <com.ximalaya.ting.android.main.view.NumberPickerView
            android:id="@+id/main_picker_minute"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/main_picker_hour"
            app:layout_constraintTop_toTopOf="parent"
            app:npv_ItemPaddingHorizontal="0dp"
            app:npv_ItemPaddingVertical="5dp"
            app:npv_RespondChangeOnDetached="false"
            app:npv_ShowDivider="false"
            app:npv_ShownCount="5"
            app:npv_TextArray="@array/arg_res_0x7f03000e"
            app:npv_TextColorNormal="@color/xm_alarm_v9514_0x7f060cbe"
            app:npv_TextColorSelected="@color/xm_alarm_v9514_0x7f060a5e"
            app:npv_TextSizeNormal="22sp"
            app:npv_TextSizeSelected="22sp"
            app:npv_WrapSelectorWheel="true"/>
        <TextView
            android:id="@+id/main_picker_minute_unit"
            android:textSize="14sp"
            android:textColor="@color/xm_alarm_v9514_0x7f0601d6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="分钟"
            app:layout_constraintBottom_toBottomOf="@+id/main_picker_minute"
            app:layout_constraintStart_toEndOf="@+id/main_picker_minute"
            app:layout_constraintTop_toTopOf="@+id/main_picker_minute"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/xm_alarm_v9514_0x7f060a5e"
        android:gravity="center"
        android:id="@+id/main_tv_cancel"
        android:background="@drawable/xm_alarm_v9514_0x7f081849"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:layout_marginBottom="27dp"
        android:text="取消"
        android:fontFamily="sans-serif-light"
        android:layout_marginStart="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/main_tv_ok"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_picker_layout"
        app:layout_constraintVertical_bias="0"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/xm_alarm_v9514_0x7f060e6d"
        android:gravity="center"
        android:id="@+id/main_tv_ok"
        android:background="@drawable/xm_alarm_v9514_0x7f081852"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="确认"
        android:layout_alignParentRight="true"
        android:fontFamily="sans-serif-light"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/main_tv_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/main_tv_cancel"
        app:layout_constraintTop_toTopOf="@+id/main_tv_cancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
