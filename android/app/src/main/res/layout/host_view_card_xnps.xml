<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/host_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/xm_feedback_xnps_white"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_csl_xnps_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:paddingTop="15dp">

            <TextView
                android:id="@+id/host_tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:textColor="@color/xm_feedback_xnps_title"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/host_iv_close"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/host_iv_close"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="关闭"
                android:src="@drawable/xm_feedback_xnps_close"
                app:layout_constraintBottom_toBottomOf="@+id/host_tv_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/host_tv_title" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.ximalaya.ting.android.host.xnps.SatisfactionView
            android:id="@+id/host_satisfaction_view_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.ximalaya.ting.android.host.xnps.XNpsScoreView
            android:id="@+id/host_xnps_scoreview_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/host_reason_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/host_tv_reason_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:textColor="@color/xm_feedback_xnps_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.ximalaya.ting.android.host.view.layout.FlowLayout
                android:id="@+id/host_reason_flowlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/host_et_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/host_reason_et"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:background="@drawable/xm_feedback_xnps_edit_background"
                    android:gravity="top"
                    android:hint="其他原因（选填）"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:maxLength="300"
                    android:maxLines="3"
                    android:padding="12dp"
                    android:textColor="@color/xm_feedback_xnps_text"
                    android:textColorHint="@color/xm_feedback_xnps_hint"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/host_tv_reason_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="0"
                    android:textColor="@color/xm_feedback_xnps_counter"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/host_tv_reason_count_right" />

                <TextView
                    android:id="@+id/host_tv_reason_count_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="/300"
                    android:textColor="@color/xm_feedback_xnps_counter"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/host_btn_layout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/host_tv_submit_white"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/xm_feedback_xnps_button_plain"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:maxLines="1"
                android:text="提交"
                android:textColor="@color/xm_feedback_xnps_disabled"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <TextView
                android:id="@+id/host_tv_submit_feedback"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:background="@drawable/xm_feedback_xnps_button_filled"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:maxLines="1"
                android:text="提交并反馈更多"
                android:textColor="@color/xm_feedback_xnps_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
