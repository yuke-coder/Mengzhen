<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/arg_res_0x7f0805ac"
    android:paddingLeft="20dp"
    android:paddingBottom="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/main_tv_title_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/arg_res_0x7f06023a"
            android:gravity="center_horizontal"
            android:id="@+id/main_tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/main_iv_sub_icon1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="标签1"
            android:layout_marginStart="6dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/main_iv_sub_icon2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="标签2"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/arg_res_0x7f06034e"
        android:ellipsize="end"
        android:id="@+id/main_tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_below="@+id/main_tv_title_layout"
        android:layout_marginEnd="20dp"
        android:layout_toStartOf="@+id/main_iv_select"
        android:layout_alignStart="@+id/main_tv_title_layout"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/main_ll_count_down_area"
        android:background="@drawable/arg_res_0x7f080642"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/main_tv_subtitle">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11sp"
            android:textColor="@color/arg_res_0x7f060561"
            android:id="@+id/main_tv_count_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#8b572a"
            android:id="@+id/main_tv_count_down_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_width="5dp"
            android:layout_height="9dp"
            android:layout_marginLeft="3dp"
            android:src="@drawable/arg_res_0x7f080890"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/main_iv_select"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/arg_res_0x7f08043c"
        android:layout_centerVertical="true"
        android:contentDescription="智能选择"
        android:layout_marginEnd="25dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/main_ll_go_for_vip"
        android:background="@drawable/arg_res_0x7f080641"
        android:paddingLeft="8dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginRight="16dp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#8b572a"
            android:id="@+id/main_tv_go_for_vip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开通会员"/>
        <ImageView
            android:layout_width="5dp"
            android:layout_height="9dp"
            android:layout_marginLeft="3dp"
            android:src="@drawable/arg_res_0x7f080890"/>
    </LinearLayout>
</RelativeLayout>
