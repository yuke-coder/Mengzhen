<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ximalaya_nickname_sheet_background">

    <com.ximalaya.ting.android.framework.view.image.FlexibleRoundImageView
        android:id="@+id/main_iv_top_img"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ximalaya_nickname_sheet_top"
        app:flexible_corner_radius="12dp"
        app:flexible_corners="left_top|right_top"
        app:layout_constraintDimensionRatio="375:76"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/main_tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:drawablePadding="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lines="1"
        android:text="@string/ximalaya_nickname_sheet_title"
        android:textColor="#A17B5D"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@id/main_iv_top_img"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/main_tv_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2dp"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:text="@string/ximalaya_nickname_sheet_skip"
        android:textColor="@color/ximalaya_nickname_sheet_skip_text"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/main_tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="19dp"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lines="1"
        android:text="@string/ximalaya_nickname_sheet_title"
        android:textColor="@color/ximalaya_nickname_sheet_primary_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_iv_top_img" />

    <com.ximalaya.ting.android.framework.view.image.RoundImageView
        android:id="@+id/main_iv_avatar"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:layout_marginTop="19dp"
        android:background="@drawable/ximalaya_nickname_avatar_background"
        android:scaleType="centerCrop"
        android:src="@drawable/ximalaya_nickname_camera"
        app:corner_radius="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_tv_subtitle"
        app:layout_goneMarginTop="19dp" />

    <Space
        android:id="@+id/main_space_avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        app:layout_constraintBottom_toBottomOf="@id/main_iv_avatar"
        app:layout_constraintEnd_toEndOf="@id/main_iv_avatar" />

    <TextView
        android:id="@+id/main_tv_upload_head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ximalaya_nickname_upload_background"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="@string/ximalaya_nickname_sheet_upload_avatar"
        android:textColor="@color/ximalaya_nickname_sheet_primary_text"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/main_iv_avatar"
        app:layout_constraintStart_toStartOf="@id/main_iv_avatar"
        app:layout_constraintTop_toBottomOf="@id/main_space_avatar" />

    <EditText
        android:id="@+id/main_et_nickname"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/ximalaya_nickname_input_background"
        android:hint="@string/ximalaya_nickname_sheet_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:lines="1"
        android:paddingStart="12dp"
        android:paddingTop="11dp"
        android:paddingEnd="12dp"
        android:paddingBottom="11dp"
        android:textColor="@color/ximalaya_nickname_sheet_primary_text"
        android:textColorHint="@color/ximalaya_nickname_sheet_hint_text"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/main_tv_sync_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_iv_avatar" />

    <TextView
        android:id="@+id/main_tv_sync_info"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="17dp"
        android:background="@drawable/ximalaya_nickname_input_background"
        android:drawableStart="@drawable/ximalaya_nickname_wechat"
        android:drawablePadding="4dp"
        android:drawableTint="@color/ximalaya_nickname_sheet_primary_text"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:lines="2"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/ximalaya_nickname_sheet_sync_wechat"
        android:textColor="@color/ximalaya_nickname_sheet_primary_text"
        android:textSize="9sp"
        app:layout_constraintBottom_toBottomOf="@id/main_et_nickname"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/main_et_nickname" />

    <View
        android:id="@+id/main_v_divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="20dp"
        android:background="@color/ximalaya_nickname_sheet_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_et_nickname" />

    <TextView
        android:id="@+id/main_tv_complete"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingTop="17dp"
        android:paddingBottom="17dp"
        android:text="@string/ximalaya_nickname_sheet_complete"
        android:textColor="@color/ximalaya_nickname_complete_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_v_divider" />

</androidx.constraintlayout.widget.ConstraintLayout>
