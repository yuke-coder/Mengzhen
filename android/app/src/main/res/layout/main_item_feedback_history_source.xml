<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/arg_res_0x7f0805ad"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/main_iv_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:contentDescription="进入"
        android:src="@drawable/xm_alarm_v9514_0x7f0809d6" />

    <TextView
        android:id="@+id/main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="#FF333333"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/main_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/main_title"
        android:layout_marginStart="15dp"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:textColor="#FF999999"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/main_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/main_title"
        android:layout_toStartOf="@id/main_iv_arrow"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:text="已提交"
        android:textColor="#FF999999"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_below="@id/main_time"
        android:layout_marginTop="15dp"
        android:background="#FFE8E8E8" />
</RelativeLayout>
