<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_cl_item"
        android:background="@drawable/arg_res_0x7f081ad1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="4dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/main_ll_btn_area"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/main_tv_title_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/arg_res_0x7f060a5e"
                    android:gravity="center_horizontal"
                    android:id="@+id/main_tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="PingFangSC-Regular"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/main_iv_sub_icon1"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:scaleType="fitXY"
                    android:contentDescription="标签1"
                    android:layout_marginStart="6dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/main_iv_sub_icon2"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:src="@drawable/arg_res_0x7f082798"
                    android:scaleType="fitXY"
                    android:contentDescription="标签2"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="normal"
                    android:textColor="@color/arg_res_0x7f060de3"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/main_tv_sub_icon3"
                    android:background="@drawable/arg_res_0x7f081bdf"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:fontFamily="PingFangSC-Regular"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="normal"
                    android:textColor="#ff4444"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/main_tv_sub_icon4"
                    android:background="@drawable/arg_res_0x7f082744"
                    android:visibility="gone"
                    android:layout_width="26dp"
                    android:layout_height="16dp"
                    android:fontFamily="PingFangSC-Regular"
                    android:layout_marginStart="8dp"/>
                <com.ximalaya.ting.android.host.view.XmLottieAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/main_lottie_select_timbre"
                    android:visibility="gone"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/arg_res_0x7f0603a2"
                android:ellipsize="end"
                android:id="@+id/main_tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/main_ll_btn_area"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/arg_res_0x7f060de3"
                android:gravity="center"
                android:id="@+id/main_tv_select"
                android:background="@drawable/arg_res_0x7f081c97"
                android:visibility="visible"
                android:layout_width="48dp"
                android:layout_height="24dp"
                android:text="使用"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/main_tv_btn_to_enjoy"
                android:background="@drawable/arg_res_0x7f080641"
                android:paddingLeft="8dp"
                android:paddingRight="6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_centerVertical="true">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#8b572a"
                    android:id="@+id/main_tv_go_for_vip_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="试听"/>
                <ImageView
                    android:layout_width="5dp"
                    android:layout_height="9dp"
                    android:layout_marginLeft="3dp"
                    android:src="@drawable/arg_res_0x7f080890"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/arg_res_0x7f060dfb"
                android:id="@+id/main_tv_btn_enjoying"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="试听中..."/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
