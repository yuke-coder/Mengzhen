<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/main_title_bar"
        layout="@layout/ximalaya_alarm_title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/arg_res_0x7f0702b1"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/main_time_picker_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp">
        <com.ximalaya.ting.android.main.view.NumberPickerView
            android:id="@+id/hour_number_picker"
            android:background="@color/xm_alarm_v9514_0x7f060e75"
            android:layout_width="wrap_content"
            android:layout_height="240dp"
            android:contentDescription="时间选择器-小时"
            app:npv_ItemPaddingHorizontal="5dp"
            app:npv_ItemPaddingVertical="10dp"
            app:npv_RespondChangeOnDetached="false"
            app:npv_ShowDivider="false"
            app:npv_ShownCount="5"
            app:npv_TextArray="@array/arg_res_0x7f03000c"
            app:npv_TextColorNormal="@color/arg_res_0x7f060a24"
            app:npv_TextColorSelected="@color/arg_res_0x7f060a24"
            app:npv_TextSizeNormal="20sp"
            app:npv_TextSizeSelected="46sp"
            app:npv_WrapSelectorWheel="true"/>
        <TextView
            android:textSize="30sp"
            android:textColor="@color/arg_res_0x7f060a24"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="29sp"
            android:text=":"/>
        <com.ximalaya.ting.android.main.view.NumberPickerView
            android:id="@+id/minute_number_picker"
            android:background="@color/xm_alarm_v9514_0x7f060e75"
            android:layout_width="wrap_content"
            android:layout_height="240dp"
            android:layout_marginLeft="29dp"
            android:contentDescription="时间选择器-分钟"
            app:npv_ItemPaddingHorizontal="5dp"
            app:npv_ItemPaddingVertical="5dp"
            app:npv_RespondChangeOnDetached="false"
            app:npv_ShowDivider="false"
            app:npv_ShownCount="5"
            app:npv_TextArray="@array/arg_res_0x7f03000e"
            app:npv_TextColorNormal="@color/arg_res_0x7f060a24"
            app:npv_TextColorSelected="@color/arg_res_0x7f060a24"
            app:npv_TextSizeNormal="20sp"
            app:npv_TextSizeSelected="46sp"
            app:npv_WrapSelectorWheel="true"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/xm_alarm_v9514_0x7f060b8a"
        android:layout_gravity="center_horizontal"
        android:id="@+id/main_alarm_time_to_wakeup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="18小时59分钟后响铃"
        android:fontFamily="Regular"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/main_alarm_repeat_ll"
                android:layout_marginTop="19dp"
                style="@style/arg_res_0x7f13046a">
                <TextView
                    android:text="设置"
                    style="@style/arg_res_0x7f1304c1"/>
                <TextView
                    android:id="@+id/main_alarm_tv_repeat_content"
                    android:text="仅一次"
                    style="@style/arg_res_0x7f1304c2"/>
            </LinearLayout>
            <View style="@style/arg_res_0x7f130469"/>
            <LinearLayout
                android:id="@+id/main_alarm_ring_name_ll"
                style="@style/arg_res_0x7f13046a">
                <TextView
                    android:text="播放内容"
                    style="@style/arg_res_0x7f1304c1"/>
                <TextView
                    android:id="@+id/main_alarm_tv_ring_name_content"
                    android:text="续播上一次收听"
                    style="@style/arg_res_0x7f1304c2"/>
            </LinearLayout>
            <View style="@style/arg_res_0x7f130469"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/main_alarm_music_ll"
                android:background="@null"
                android:visibility="gone"
                style="@style/arg_res_0x7f13046a">
                <TextView
                    android:id="@+id/main_alarm_tv_music_title"
                    android:text="轻唤醒"
                    app:layout_constraintBottom_toTopOf="@+id/main_alarm_tv_music_desc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    style="@style/arg_res_0x7f1304c1"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/xm_alarm_v9514_0x7f0603a2"
                    android:ellipsize="end"
                    android:id="@+id/main_alarm_tv_music_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="播放内容前，先播放30秒轻柔音乐"
                    android:maxLines="1"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/main_music_switch"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/main_alarm_tv_music_title"/>
                <CheckBox
                    android:id="@+id/main_music_switch"
                    android:background="@drawable/xm_alarm_v9514_0x7f080dd7"
                    android:layout_width="50dp"
                    android:layout_height="26dp"
                    android:button="@null"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:background="@color/arg_res_0x7f060138"
                android:layout_width="match_parent"
                android:layout_height="10dp"/>
            <RelativeLayout
                android:id="@+id/main_alarm_preview_air_report_ll"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="60dp">
                <TextView
                    android:text="开头播放天气预报"
                    android:drawableRight="@null"
                    style="@style/arg_res_0x7f1304c0"/>
                <CheckBox
                    android:id="@+id/main_alarm_preview_air_report_cb"
                    android:background="@drawable/xm_alarm_v9514_0x7f080dd5"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="15dp"
                    android:button="@null"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <View
                android:visibility="gone"
                style="@style/arg_res_0x7f130469"/>
            <LinearLayout
                android:id="@+id/main_alarm_reporter_ll"
                android:visibility="gone"
                style="@style/arg_res_0x7f13046a">
                <TextView
                    android:text="播报员"
                    style="@style/arg_res_0x7f1304c1"/>
                <TextView
                    android:id="@+id/main_alarm_tv_reporter_content"
                    android:text="岳云鹏"
                    style="@style/arg_res_0x7f1304c2"/>
            </LinearLayout>
            <View
                android:id="@+id/main_alarm_setting_divide_1"
                android:visibility="gone"
                style="@style/arg_res_0x7f130469"/>
            <LinearLayout
                android:id="@+id/main_alarm_location_ll"
                android:visibility="gone"
                style="@style/arg_res_0x7f13046a">
                <TextView
                    android:text="地理位置"
                    style="@style/arg_res_0x7f1304c1"/>
                <TextView
                    android:id="@+id/main_alarm_tv_location_content"
                    android:text=""
                    style="@style/arg_res_0x7f1304c2"/>
            </LinearLayout>
            <View
                android:id="@+id/main_alarm_setting_divide_2"
                android:visibility="gone"
                style="@style/arg_res_0x7f130469"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="16dp"
                layout="@layout/main_fra_alarm_tips"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
