<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="40dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/n7r"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/qq_source_player_style_header"/>
    <com.tencent.qqmusic.business.customskin.player.view.BtnTypeSeekbarView
        android:id="@+id/n91"
        android:paddingLeft="20dp"
        android:paddingTop="29dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:btnTypeSeekbar_sectionPointColor="#00f168"
        app:btnTypeSeekbar_selectedTextColor="#ffffff"
        app:btnTypeSeekbar_textArray="小,标准,大,超大"
        app:btnTypeSeekbar_textSize="14dp"
        app:layout_constraintTop_toBottomOf="@+id/n7r"/>
</androidx.constraintlayout.widget.ConstraintLayout>
