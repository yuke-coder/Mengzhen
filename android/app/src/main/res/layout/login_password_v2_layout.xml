<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/arg_res_0x7f0605be"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/login_v2_pwd_close_btn"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/arg_res_0x7f0817b3"
        android:contentDescription="@null"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/arg_res_0x7f060224"
        android:id="@+id/login_v2_pwd_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="144dp"
        android:text="请输入密码"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/login_v2_pwd_account_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_v2_pwd_title">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/arg_res_0x7f060555"
            android:id="@+id/login_v2_pwd_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="182 8888 4047"/>
        <View
            android:background="@color/arg_res_0x7f06041a"
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginStart="9dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/arg_res_0x7f060224"
            android:id="@+id/login_v2_pwd_change_account"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="换号"
            android:drawableLeft="@drawable/arg_res_0x7f0817c4"
            android:drawablePadding="4dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginStart="9dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/login_v2_pwd_input_container"
        android:background="@drawable/arg_res_0x7f081789"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="50dp"
        android:layout_marginRight="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_v2_pwd_account_row">
        <ImageView
            android:id="@+id/login_v2_pwd_lock_icon"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/arg_res_0x7f0817c8"
            android:tint="@color/arg_res_0x7f060224"
            android:contentDescription="@null"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"/>
        <View
            android:background="@color/arg_res_0x7f06041a"
            android:layout_width="1dp"
            android:layout_height="16dp"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/arg_res_0x7f060224"
            android:textColorHint="@color/arg_res_0x7f06027d"
            android:id="@+id/login_v2_pwd_input"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="请输入密码"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="textPassword"
            android:textCursorDrawable="@drawable/arg_res_0x7f081795"
            android:layout_marginStart="10dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/arg_res_0x7f060363"
            android:id="@+id/login_v2_pwd_forget"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="忘记密码?"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
    <FrameLayout
        android:enabled="false"
        android:id="@+id/login_v2_pwd_btn"
        android:background="@drawable/arg_res_0x7f08178b"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_v2_pwd_input_container">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/login_v2_pwd_loading"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/chatgpt_loading_spinner"
                android:tint="@color/arg_res_0x7f06080f"
                android:contentDescription="@null"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/arg_res_0x7f06080f"
                android:id="@+id/login_v2_pwd_btn_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="登录"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
