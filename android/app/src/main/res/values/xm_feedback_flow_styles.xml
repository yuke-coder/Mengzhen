<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="XmFeedbackInfoRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">25dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingEnd">25dp</item>
        <item name="android:paddingBottom">17dp</item>
    </style>

    <style name="XmFeedbackInfoLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#FF333333</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="XmFeedbackInfoValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FF999999</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
