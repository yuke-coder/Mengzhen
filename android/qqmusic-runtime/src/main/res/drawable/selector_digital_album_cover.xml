<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <stroke android:width="3.0dp" android:color="@color/digital_album_cover_select" />
            <corners android:radius="7.5dp" />
            <padding android:left="2.0dp" android:top="2.0dp" android:right="2.0dp" android:bottom="2.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="0.0dp" android:color="@android:color/transparent" />
            <corners android:radius="7.5dp" />
            <padding android:left="2.0dp" android:top="2.0dp" android:right="2.0dp" android:bottom="2.0dp" />
        </shape>
    </item>
</selector>
