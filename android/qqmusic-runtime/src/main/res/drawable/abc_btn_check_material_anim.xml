<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:id="@id/ay7" android:drawable="@drawable/btn_checkbox_checked_mtrl" />
    <item android:id="@id/mt9" android:drawable="@drawable/btn_checkbox_unchecked_mtrl" />
