<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="10.0dp" />
            <gradient android:startColor="#7a6a6a6a" android:endColor="#9a6a6a6a" android:angle="0.0" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="10.0dp" />
                <gradient android:startColor="#3ce68e" android:endColor="#00e79d" android:angle="0.0" />
            </shape>
        </clip>
    </item>
</layer-list>
