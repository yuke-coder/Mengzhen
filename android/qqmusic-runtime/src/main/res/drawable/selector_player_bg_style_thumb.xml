<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="false">
        <shape android:shape="oval">
            <solid android:color="#ffffff" />
            <size android:height="20.0dp" android:width="20.0dp" />
            <stroke android:width="1.0dp" android:color="@color/player_style_switch_normal_color" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="#ffffff" />
            <size android:height="20.0dp" android:width="20.0dp" />
            <stroke android:width="1.0dp" android:color="@color/ss_highlight_color" />
        </shape>
    </item>
</selector>
