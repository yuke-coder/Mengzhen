<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <stroke android:width="1.0dp" android:color="@color/my_music_green" />
            <corners android:radius="7.5dp" />
            <padding android:left="1.0dp" android:top="1.0dp" android:right="1.0dp" android:bottom="1.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="0.0dp" android:color="@android:color/transparent" />
            <corners android:radius="7.5dp" />
            <padding android:left="1.0dp" android:top="1.0dp" android:right="1.0dp" android:bottom="1.0dp" />
        </shape>
    </item>
</selector>
