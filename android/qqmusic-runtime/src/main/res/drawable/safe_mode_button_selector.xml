<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#f0f0f0" />
            <stroke android:width="1.0dp" android:color="#9c9c9c" />
            <corners android:radius="3.0dp" />
            <padding android:left="10.0dp" android:top="1.0dp" android:right="10.0dp" android:bottom="10.0dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#f0f0f0" />
            <stroke android:width="1.0dp" android:color="#9c9c9c" />
            <corners android:radius="3.0dp" />
            <padding android:left="10.0dp" android:top="10.0dp" android:right="10.0dp" android:bottom="10.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#ffffff" />
            <stroke android:width="1.0dp" android:color="#000000" />
            <corners android:radius="3.0dp" />
            <padding android:left="10.0dp" android:top="10.0dp" android:right="10.0dp" android:bottom="10.0dp" />
        </shape>
    </item>
</selector>
