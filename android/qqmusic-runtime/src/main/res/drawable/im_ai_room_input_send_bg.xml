<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <corners android:radius="15.0dp" />
            <solid android:color="@color/skin_highlight_color" />
            <stroke android:width="1.0px" android:color="@color/skin_highlight_color" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="15.0dp" />
            <solid android:color="@color/black_8_opacity" />
            <stroke android:width="1.0px" android:color="@color/black_8_opacity" />
        </shape>
    </item>
</selector>
