<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="10.0dp" />
            <size android:height="60.0dp" />
            <solid android:color="@color/white_15_transparent" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:gravity="left" android:clipOrientation="horizontal">
            <shape>
                <corners android:radius="10.0dp" />
                <gradient android:startColor="#47b9ff" android:endColor="#2ce7b8" android:angle="180.0" />
                <size android:height="60.0dp" />
            </shape>
        </clip>
    </item>
</layer-list>
