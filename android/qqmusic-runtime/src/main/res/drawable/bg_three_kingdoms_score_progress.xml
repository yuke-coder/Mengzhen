            <corners android:radius="4.6999817dp" />
            <solid android:color="#ffffff" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <inset android:insetLeft="1.5dp" android:insetRight="1.5dp" android:insetTop="1.2999878dp" android:insetBottom="1.2999878dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3.399994dp" />
                    <gradient android:angle="0.0" />
                </shape>
            </inset>
        </scale>
    </item>
</layer-list>
