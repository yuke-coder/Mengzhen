<?xml version="1.0" encoding="utf-8"?>
<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:id="@id/nkm" android:drawable="@drawable/design_ic_visibility" />
    <item android:id="@id/g1n" android:drawable="@drawable/design_ic_visibility_off" />
    <transition android:drawable="@drawable/avd_show_password" android:toId="@id/nkm" android:fromId="@id/g1n" />
    <transition android:drawable="@drawable/avd_hide_password" android:toId="@id/g1n" android:fromId="@id/nkm" />
</animated-selector>
