<?xml version="1.0" encoding="utf-8"?>
<set android:interpolator="@android:anim/linear_interpolator" android:shareInterpolator="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha android:duration="160" android:startOffset="3000" android:fromAlpha="0.0" android:toAlpha="1.0" />
    <rotate android:duration="3000" android:fromDegrees="0.0" android:toDegrees="360.0" android:pivotX="50.0%" android:pivotY="50.0%" android:startOffset="0" android:repeatCount="infinite" />
</set>
