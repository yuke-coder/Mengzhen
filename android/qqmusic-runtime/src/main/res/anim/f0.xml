<?xml version="1.0" encoding="utf-8"?>
<set android:interpolator="@android:anim/bounce_interpolator"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha android:duration="340" android:fillAfter="true" android:startOffset="2700" android:fromAlpha="0.0" android:toAlpha="1.0" />
    <scale android:duration="340" android:pivotX="50.0%" android:pivotY="50.0%" android:fillAfter="true" android:startOffset="2700" android:fromXScale="2.0" android:toXScale="1.0" android:fromYScale="2.0" android:toYScale="1.0" />
    <translate android:duration="500" android:fillAfter="true" android:startOffset="2700" android:fromXDelta="-50.0%" android:toXDelta="0.0%" android:fromYDelta="50.0%" android:toYDelta="0.0%" />
</set>
