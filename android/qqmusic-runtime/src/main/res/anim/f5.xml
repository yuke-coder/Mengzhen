<?xml version="1.0" encoding="utf-8"?>
<set android:interpolator="@android:anim/linear_interpolator" android:shareInterpolator="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <scale android:duration="300" android:pivotX="50.0%" android:pivotY="50.0%" android:fillAfter="true" android:fromXScale="3.0" android:toXScale="1.0" android:fromYScale="3.0" android:toYScale="1.0" />
    <alpha android:duration="300" android:fillAfter="true" android:fromAlpha="0.0" android:toAlpha="1.0" />
    <rotate android:duration="150" android:fromDegrees="-15.0" android:toDegrees="15.0" android:pivotX="50.0%" android:pivotY="50.0%" android:fillAfter="false" android:repeatCount="8" android:repeatMode="reverse" />
</set>
