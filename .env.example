# ============================================================================
# 梦枕项目 - 环境变量配置模板
# 使用方法：复制此文件为 .env.local，填写实际值
# 部署到 Vercel/其他平台时，在对应平台的环境变量管理处设置
# ============================================================================

# ---- Supabase 数据库配置（必需）----
# 在 Supabase 控制台的 Project Settings → API 中获取
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- 音频可恢复上传（可选）----
# 官方 *.supabase.co 域名默认启用；自定义存储网关默认关闭并使用签名直传。
# 只有确认自定义网关兼容 Supabase Signed TUS 后才设置为 true。
# AUDIO_TUS_ENABLED=false

# ---- Next.js 配置（可选）----
# 生产环境部署时设为 production
NODE_ENV=production

# 公开站点根地址（SEO、分享链接与原生客户端统一使用）
NEXT_PUBLIC_SITE_URL=https://driftcue.com

# ---- 微信资料同步（可选）----
# 微信开放平台移动应用 AppID；Android 构建使用的 WECHAT_APP_ID 必须与此一致。
WECHAT_APP_ID=wx_your_app_id
# 仅配置在服务端或 Vercel，禁止写入 Android local.properties 或打包进 APK。
WECHAT_APP_SECRET=your-wechat-app-secret

# ---- 说明 ----
# 缺少 SUPABASE_URL 或 SUPABASE_SERVICE_ROLE_KEY 时，所有 API 路由
# （登录/注册/音频上传等）将返回："数据库服务未配置，请联系管理员"
#
# SUPABASE_SERVICE_ROLE_KEY 是服务端密钥，有 bypass RLS 的权限
# 只在服务端代码中使用，不要暴露给客户端

# APK 下载地址（Supabase Storage 公开 URL）
NEXT_PUBLIC_APK_DOWNLOAD_URL=

# ---- Cloudflare Turnstile 人机验证配置（必需）----
# 在 Cloudflare 后台 → Turnstile → Add Widget 创建后获取
# Widget Mode 选 Managed（托管模式）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key
